{
  "swagger": "2.0",
  "info": {
    "title": "Claude (Anthropic Messages API)",
    "description": "Talk to Claude from a Copilot Studio agent / Power Automate flow published to Teams. One action, SendMessage, calls the Anthropic Messages API. The API is stateless: pass the full conversation history in `messages` each turn.",
    "version": "1.0.0"
  },
  "host": "api.anthropic.com",
  "basePath": "/",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "api_key": {
      "type": "apiKey",
      "in": "header",
      "name": "x-api-key",
      "description": "Your Anthropic API key (sk-ant-...). Stored in the connector's connection, never in the agent."
    }
  },
  "security": [{"api_key": []}],
  "paths": {
    "/v1/messages": {
      "post": {
        "operationId": "SendMessage",
        "summary": "Send a message to Claude and get a reply",
        "description": "Sends the conversation to Claude and returns the assistant reply. Read content[0].text for the text to post back in Teams.",
        "parameters": [
          {
            "name": "anthropic-version",
            "in": "header",
            "required": true,
            "type": "string",
            "default": "2023-06-01",
            "x-ms-visibility": "internal"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {"$ref": "#/definitions/MessageRequest"}
          }
        ],
        "responses": {
          "200": {"description": "Claude's reply", "schema": {"$ref": "#/definitions/MessageResponse"}},
          "400": {"description": "Bad request"},
          "401": {"description": "Invalid API key"},
          "429": {"description": "Rate limited"}
        }
      }
    }
  },
  "definitions": {
    "MessageRequest": {
      "type": "object",
      "required": ["model", "max_tokens", "messages"],
      "properties": {
        "model": {
          "type": "string",
          "default": "claude-opus-4-8",
          "description": "claude-opus-4-8 (most capable) or claude-sonnet-5 (cheaper/faster for high-volume chat)"
        },
        "max_tokens": {"type": "integer", "default": 2048, "description": "Max tokens in the reply"},
        "system": {
          "type": "string",
          "description": "System prompt — the assistant's persona/instructions",
          "default": "You are a helpful assistant for the McAllister & Quinn team, answering in Microsoft Teams. Be concise and clear."
        },
        "messages": {
          "type": "array",
          "description": "Full conversation history, oldest first. Roles alternate user/assistant; first must be user.",
          "items": {"$ref": "#/definitions/Message"}
        }
      }
    },
    "Message": {
      "type": "object",
      "required": ["role", "content"],
      "properties": {
        "role": {"type": "string", "enum": ["user", "assistant"]},
        "content": {"type": "string"}
      }
    },
    "MessageResponse": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "model": {"type": "string"},
        "stop_reason": {"type": "string"},
        "role": {"type": "string"},
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {"type": "string"},
              "text": {"type": "string"}
            }
          }
        },
        "usage": {
          "type": "object",
          "properties": {
            "input_tokens": {"type": "integer"},
            "output_tokens": {"type": "integer"}
          }
        }
      }
    }
  }
}
