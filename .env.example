# Copy to .env and fill in. Fetch scripts read these automatically.
# .env is gitignored. Never commit real keys.

# data.gov API key - powers the College Scorecard fetch (institution facts,
# Carnegie classification, MSI designations, enrollment, selectivity, student
# demographics). DEMO_KEY works for light testing but is rate-limited.
# Register (free): https://api.data.gov/signup/
DATA_GOV_API_KEY=

# Congress.gov API. Free. Powers the delegation lookup for the CDS section.
# Register: https://api.congress.gov/sign-up/
CONGRESS_API_KEY=

# USA Spending (institution federal award history) and ProPublica Nonprofit
# Explorer (990 financials) need no key.
